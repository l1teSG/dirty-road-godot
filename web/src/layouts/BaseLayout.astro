---
/**
 * Layout base para todas las páginas de Dirty Road.
 * Importa los estilos globales, define la estructura HTML principal
 * y aplica el fondo oscuro característico del juego.
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dirty Road',
  description = 'Shooter de supervivencia minimalista con temática ecológica. Sobrevive a enemigos geométricos que representan la contaminación.',
} = Astro.props;

// URLs absolutas para canónicas y tarjetas sociales (requieren `site` en astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/juego/og.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="grain relative min-h-screen bg-bg font-display text-bone antialiased">
    <slot />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Aparición al entrar en viewport (opacidad + ascenso + desenfoque).
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce) {
        revealTargets.forEach((el) => el.classList.add('visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        revealTargets.forEach((el) => io.observe(el));
      }

      // 2) Contadores animados (10 etapas, 100 oleadas, 40 enemigos…).
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (counters.length) {
        const easeOut = (k: number) => 1 - Math.pow(1 - k, 3);
        const ioCount = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              ioCount.unobserve(el);
              const target = Number(el.dataset.count) || 0;
              if (reduce) {
                el.textContent = target.toLocaleString('es-CO');
                continue;
              }
              const t0 = performance.now();
              const dur = 1200;
              const step = (now: number) => {
                const k = Math.min((now - t0) / dur, 1);
                el.textContent = Math.round(target * easeOut(k)).toLocaleString('es-CO');
                if (k < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            }
          },
          { threshold: 0.4 },
        );
        counters.forEach((c) => ioCount.observe(c));
      }

      // 3) Parallax/rotación ligados al scroll + barra de progreso + estado del nav.
      const parallaxEls = Array.from(
        document.querySelectorAll<HTMLElement>('[data-parallax], [data-rotate]'),
      );
      const progress = document.getElementById('scroll-progress');
      const nav = document.getElementById('site-nav');
      const menuPanel = document.getElementById('menu-panel');
      let lastY = 0;

      const updateOnScroll = () => {
        const vh = window.innerHeight || 1;
        const sy = window.scrollY || 0;

        const docH = document.documentElement.scrollHeight - vh;
        const p = docH > 0 ? Math.min(Math.max(sy / docH, 0), 1) : 0;
        if (progress) progress.style.transform = `scaleX(${p})`;

        // Auto-ocultar el dock al bajar, mostrar al subir (salvo menú abierto).
        if (nav) {
          const menuOpen = menuPanel && !menuPanel.classList.contains('hidden');
          if (sy < 80 || (sy < lastY && !menuOpen)) nav.classList.remove('is-hidden');
          else if (sy > lastY && !menuOpen) nav.classList.add('is-hidden');
        }
        lastY = sy;

        if (reduce) return;
        for (const el of parallaxEls) {
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const rel = (center - vh / 2) / vh; // ~ -1 .. 1 según la posición
          const speed = Number(el.dataset.parallax) || 0;
          const rot = Number(el.dataset.rotate) || 0;
          const y = -rel * speed * 100;
          let tf = `translate3d(0, ${y.toFixed(1)}px, 0)`;
          if (rot) tf += ` rotate(${(-rel * rot).toFixed(2)}deg)`;
          el.style.transform = tf;
        }
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateOnScroll();
          ticking = false;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateOnScroll();

      // 4) Al hacer clic en un enlace interno, la sección de destino "destella"
      //    con su propio color cuando el scroll llega (sensación de foco).
      let destino: HTMLElement | null = null;

      const destellar = (el: HTMLElement) => {
        const tint =
          el.dataset.tint ||
          el.closest<HTMLElement>('[data-tint]')?.dataset.tint ||
          getComputedStyle(document.documentElement).getPropertyValue('--color-leaf').trim() ||
          '#8ec74a';
        el.style.setProperty('--flash', tint);
        el.classList.remove('target-flash');
        void el.offsetWidth; // reinicia la animación
        el.classList.add('target-flash');
        window.setTimeout(() => el.classList.remove('target-flash'), 1600);
      };

      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element | null)?.closest?.('a[href^="#"]');
        if (!(a instanceof HTMLAnchorElement)) return;
        const id = a.getAttribute('href')?.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        if (el) destino = el;
      });

      const alTerminarScroll = () => {
        if (!destino) return;
        const el = destino;
        destino = null;
        if (!reduce) destellar(el);
      };

      // `scrollend` donde exista; y un debounce de respaldo para el resto.
      window.addEventListener('scrollend', alTerminarScroll);
      let espera: number | undefined;
      window.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(espera);
          espera = window.setTimeout(alTerminarScroll, 160);
        },
        { passive: true },
      );
    </script>
  </body>
</html>
