---
/**
 * Layout base para todas las páginas de Dirty Road.
 * Importa los estilos globales, define la estructura HTML principal
 * y aplica el fondo oscuro característico del juego.
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dirty Road',
  description = 'Shooter de supervivencia minimalista con temática ecológica. Sobrevive a enemigos geométricos que representan la contaminación.',
} = Astro.props;

// URLs absolutas para canónicas y tarjetas sociales (requieren `site` en astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/juego/og.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="grain relative min-h-screen bg-bg font-display text-bone antialiased">
    <slot />
    <script>
      // Animación de aparición al hacer scroll (Reveal).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
