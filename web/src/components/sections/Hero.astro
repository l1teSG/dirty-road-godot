---
import { getImage } from 'astro:assets';
import posterEtapa from '../../media/juego/etapas/etapa_01.png';

const posterHero = await getImage({ src: posterEtapa, format: 'webp', width: 1280 });

// Héroe: el único momento orquestado de la página. A la izquierda, el título
// como etiqueta de espécimen. A la derecha, una "ventana cinematográfica":
// el gameplay ocupa el panel y encima va un HUD (medidor de contaminación vivo
// + totales).
// Índice de contaminación inicial (el script lo anima con el scroll).
const indice = 7;
const total = 10;
---

<section id="top" class="relative isolate overflow-hidden border-b border-line">
  <div class="field-grid pointer-events-none absolute inset-x-0 -top-32 -bottom-32 opacity-30" aria-hidden="true" data-parallax="0.12"></div>

  <div
    class="mx-auto grid min-h-screen max-w-6xl items-center gap-14 px-4 pb-20 pt-28 md:grid-cols-[1.08fr_0.92fr]"
  >
    <div>
      <p class="rise flex items-center gap-3 text-sm text-moss" style="animation-delay:.05s">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-leaf"></span>
        </span>
        Ecosistema en observación
      </p>

      <h1
        class="rise mt-6 text-[clamp(3.2rem,11vw,7.5rem)] font-bold leading-[0.86] tracking-[-0.03em]"
        style="animation-delay:.12s"
      >
        <span class="block text-bone">Dirty</span>
        <span class="block text-leaf">Road</span>
      </h1>

      <p class="rise mt-7 max-w-[48ch] text-lg leading-relaxed text-moss" style="animation-delay:.22s">
        Defiende el último árbol contra oleadas de contaminación. Recolecta, recicla y
        reforesta en un <em class="not-italic text-bone">survival</em> infinito donde cada
        enemigo es un problema ambiental real.
      </p>

      <div class="rise mt-9 flex flex-wrap items-center gap-x-8 gap-y-4" style="animation-delay:.32s">
        <a
          href="#descargar"
          class="inline-flex items-center rounded-[3px] bg-resin px-7 py-3 font-semibold text-bg shadow-glow-resin transition-colors hover:bg-[#f0b451]"
        >
          Descargar gratis
        </a>
        <a href="#mecanicas" class="group inline-flex items-center gap-3 font-medium text-bone transition-colors hover:text-leaf">
          Ver mecánicas
          <span class="h-px w-8 bg-leaf transition-all duration-300 group-hover:w-14" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <div class="rise" style="animation-delay:.30s">
      <div
        class="relative overflow-hidden rounded-[4px] border border-line bg-surface"
        data-parallax="0.04"
      >
        <video
          class="aspect-video w-full object-cover"
          src="/video/trailer.mp4"
          poster={posterHero.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Gameplay de Dirty Road"
        ></video>

        <!-- Velo para que el HUD siempre se lea sobre el video -->
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#050a08] via-[#050a08]/15 to-transparent"
          aria-hidden="true"
        ></div>

        <!-- HUD inferior: medidor vivo + totales -->
        <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
          <div class="flex items-baseline justify-between text-xs">
            <span class="text-moss">Índice de contaminación</span>
            <span class="font-semibold text-resin"><span id="indice-valor">{indice}</span> / {total}</span>
          </div>
          <div class="mt-2 flex gap-[3px]" aria-hidden="true">
            {Array.from({ length: total }).map((_, i) => (
              <span
                data-indice-bar
                class={`h-1.5 flex-1 rounded-[1px] ${i < indice ? 'bg-resin' : 'bg-surface-2'}`}
              />
            ))}
          </div>
          <div class="mt-3 grid grid-cols-3 gap-3 border-t border-line-strong/40 pt-3 text-xs">
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="10">0</p>
              <p class="text-moss">etapas</p>
            </div>
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="100">0</p>
              <p class="text-moss">oleadas</p>
            </div>
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="40">0</p>
              <p class="text-moss">enemigos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Contaminómetro vivo: sube con el progreso de lectura de la página.
  const indiceValor = document.getElementById('indice-valor');
  const barras = Array.from(document.querySelectorAll<HTMLElement>('[data-indice-bar]'));
  if (indiceValor && barras.length) {
    const actualizarIndice = () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const p = docH > 0 ? Math.min(Math.max(window.scrollY / docH, 0), 1) : 0;
      const idx = Math.round(p * barras.length);
      indiceValor.textContent = String(idx);
      barras.forEach((b, i) => {
        b.classList.toggle('bg-resin', i < idx);
        b.classList.toggle('bg-surface-2', i >= idx);
      });
    };
    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        actualizarIndice();
        pendiente = false;
      });
    };
    window.addEventListener('scroll', alScroll, { passive: true });
    actualizarIndice();
  }
</script>
