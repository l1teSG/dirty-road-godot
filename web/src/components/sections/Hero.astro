---
import Reveal from '../ui/Reveal.astro';
---
<section id="top" class="relative flex min-h-screen flex-col items-center justify-center px-4 text-center">
  <Reveal>
    <p class="font-mono text-xs uppercase tracking-[0.4em] text-green">
      Videojuego educativo ambiental
    </p>
    <h1 class="mt-5 text-5xl font-bold leading-none tracking-tight text-text-primary sm:text-7xl md:text-8xl">
      DIRTY<span class="text-green-bright"> ROAD</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
      Defiende el último árbol contra oleadas de contaminación. Recolecta, recicla,
      reforesta y sobrevive en un shooter de supervivencia con temática ecológica.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="#descargar"
        class="rounded-full bg-green px-8 py-3 font-semibold text-bg shadow-glow-green transition-transform hover:scale-105"
      >
        Descargar gratis
      </a>
      <a
        href="#que-es"
        class="rounded-full border border-green/40 px-8 py-3 font-semibold text-green-bright transition-colors hover:bg-green/10"
      >
        Descubre más
      </a>
    </div>
  </Reveal>
  <div class="absolute bottom-10 animate-bounce font-mono text-xs text-text-secondary">
    ↓ desliza
  </div>
</section>
