---
// Héroe: el único momento orquestado de la página. A la izquierda, el título
// como etiqueta de espécimen. A la derecha, una "ventana al juego" que alterna
// entre el gameplay (trailer) y el instrumento de anillos del Árbol, más el
// índice de contaminación (vivo: sube con el scroll) y los totales del juego.
const anillos = [
  { r: 24, w: 1.5, c: 'leaf', o: 0.95, d: '0.30s' },
  { r: 44, w: 1, c: 'leaf', o: 0.6, d: '0.40s' },
  { r: 60, w: 3, c: 'rust', o: 0.9, d: '0.50s' }, // un año malo
  { r: 80, w: 1, c: 'leaf', o: 0.55, d: '0.60s' },
  { r: 101, w: 1.5, c: 'leaf', o: 0.4, d: '0.70s' },
  { r: 116, w: 1, c: 'leaf', o: 0.25, d: '0.80s' },
];

// Índice de contaminación inicial (el script lo anima con el scroll).
const indice = 7;
const total = 10;
---

<section id="top" class="relative isolate overflow-hidden border-b border-line">
  <div class="field-grid pointer-events-none absolute inset-x-0 -top-32 -bottom-32 opacity-30" aria-hidden="true" data-parallax="0.12"></div>

  <div
    class="mx-auto grid min-h-screen max-w-6xl items-center gap-14 px-4 pb-20 pt-28 md:grid-cols-[1.08fr_0.92fr]"
  >
    <div>
      <p class="rise flex items-center gap-3 text-sm text-moss" style="animation-delay:.05s">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-leaf"></span>
        </span>
        Ecosistema en observación
      </p>

      <h1
        class="rise mt-6 text-[clamp(3.2rem,11vw,7.5rem)] font-bold leading-[0.86] tracking-[-0.03em]"
        style="animation-delay:.12s"
      >
        <span class="block text-bone">Dirty</span>
        <span class="block text-leaf">Road</span>
      </h1>

      <p class="rise mt-7 max-w-[48ch] text-lg leading-relaxed text-moss" style="animation-delay:.22s">
        Defiende el último árbol contra oleadas de contaminación. Recolecta, recicla y
        reforesta en un <em class="not-italic text-bone">survival</em> infinito donde cada
        enemigo es un problema ambiental real.
      </p>

      <div class="rise mt-9 flex flex-wrap items-center gap-x-8 gap-y-4" style="animation-delay:.32s">
        <a
          href="#descargar"
          class="inline-flex items-center rounded-[3px] bg-resin px-7 py-3 font-semibold text-bg shadow-glow-resin transition-colors hover:bg-[#f0b451]"
        >
          Descargar gratis
        </a>
        <a href="#mecanicas" class="group inline-flex items-center gap-3 font-medium text-bone transition-colors hover:text-leaf">
          Ver mecánicas
          <span class="h-px w-8 bg-leaf transition-all duration-300 group-hover:w-14" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <div class="rise" style="animation-delay:.30s">
      <div class="tile relative overflow-hidden p-4 sm:p-6" data-parallax="0.04">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-medium text-bone">Ventana al juego</p>
          <div class="flex shrink-0 rounded-full border border-line p-0.5 text-xs" role="group" aria-label="Qué ver en la ventana">
            <button
              data-ver="gameplay"
              class="rounded-full bg-surface-2 px-3 py-1 font-medium text-bone transition-colors"
              aria-pressed="true"
            >
              Gameplay
            </button>
            <button
              data-ver="instrumento"
              class="rounded-full px-3 py-1 font-medium text-moss transition-colors hover:text-bone"
              aria-pressed="false"
            >
              Instrumento
            </button>
          </div>
        </div>

        <div class="mt-4">
          <video
            data-panel="gameplay"
            class="aspect-video w-full rounded-[3px] border border-line bg-surface object-cover"
            src="/video/trailer.mp4"
            poster="/images/juego/etapas/etapa_01.png"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Gameplay de Dirty Road"
          ></video>

          <div data-panel="instrumento" class="hidden">
            <div class="flex aspect-video w-full items-center justify-center">
              <div class="mx-auto max-w-[240px]" data-rotate="4">
                <svg viewBox="0 0 240 240" class="w-full" role="img" aria-label="Corte transversal del tronco con sus anillos de crecimiento">
                  <g fill="none">
                    {anillos.map((a) => (
                      <circle
                        cx="120"
                        cy="120"
                        r={a.r}
                        stroke-width={a.w}
                        class="ring-in"
                        style={`stroke:var(--color-${a.c});opacity:${a.o};animation-delay:${a.d}`}
                      />
                    ))}
                  </g>
                  <!-- radios: el tronco leído como dato -->
                  <g stroke="var(--color-leaf)" stroke-width="1" opacity="0.28">
                    {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => (
                      <line
                        x1="120"
                        y1="120"
                        x2={120 + 116 * Math.cos((deg * Math.PI) / 180)}
                        y2={120 + 116 * Math.sin((deg * Math.PI) / 180)}
                      />
                    ))}
                  </g>
                  <circle cx="120" cy="120" r="5" fill="var(--color-leaf)" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <div class="flex items-baseline justify-between text-sm">
            <span class="text-moss">Índice de contaminación</span>
            <span class="font-semibold text-resin"><span id="indice-valor">{indice}</span> / {total}</span>
          </div>
          <div class="mt-2 flex gap-[3px]" aria-hidden="true">
            {Array.from({ length: total }).map((_, i) => (
              <span
                data-indice-bar
                class={`h-2 flex-1 rounded-[1px] ${i < indice ? 'bg-resin' : 'bg-surface-2'}`}
              />
            ))}
          </div>
          <div class="mt-5 grid grid-cols-3 gap-4 border-t border-line pt-4 text-sm">
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="10">0</p>
              <p class="text-moss">etapas</p>
            </div>
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="100">0</p>
              <p class="text-moss">oleadas</p>
            </div>
            <div>
              <p class="font-semibold tabular-nums text-bone" data-count="40">0</p>
              <p class="text-moss">enemigos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Toggle de la "ventana al juego": Gameplay (trailer) o Instrumento (árbol).
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ver]'));
  const panelGameplay = document.querySelector<HTMLElement>('[data-panel="gameplay"]');
  const panelInstrumento = document.querySelector<HTMLElement>('[data-panel="instrumento"]');
  const video = panelGameplay instanceof HTMLVideoElement ? panelGameplay : null;

  const activo = 'rounded-full bg-surface-2 px-3 py-1 font-medium text-bone transition-colors';
  const inactivo =
    'rounded-full px-3 py-1 font-medium text-moss transition-colors hover:text-bone';

  const mostrar = (modo: string) => {
    const esGameplay = modo === 'gameplay';
    panelGameplay?.classList.toggle('hidden', !esGameplay);
    panelInstrumento?.classList.toggle('hidden', esGameplay);
    if (video) {
      if (esGameplay) void video.play().catch(() => {});
      else video.pause();
    }
    for (const b of botones) {
      const on = b.dataset.ver === modo;
      b.setAttribute('aria-pressed', String(on));
      b.className = on ? activo : inactivo;
    }
  };

  for (const b of botones) {
    b.addEventListener('click', () => mostrar(b.dataset.ver || 'gameplay'));
  }

  // Contaminómetro vivo: sube con el progreso de lectura de la página.
  const indiceValor = document.getElementById('indice-valor');
  const barras = Array.from(document.querySelectorAll<HTMLElement>('[data-indice-bar]'));
  if (indiceValor && barras.length) {
    const actualizarIndice = () => {
      const docH = document.documentElement.scrollHeight - window.innerHeight;
      const p = docH > 0 ? Math.min(Math.max(window.scrollY / docH, 0), 1) : 0;
      const idx = Math.round(p * barras.length);
      indiceValor.textContent = String(idx);
      barras.forEach((b, i) => {
        b.classList.toggle('bg-resin', i < idx);
        b.classList.toggle('bg-surface-2', i >= idx);
      });
    };
    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        actualizarIndice();
        pendiente = false;
      });
    };
    window.addEventListener('scroll', alScroll, { passive: true });
    actualizarIndice();
  }
</script>
