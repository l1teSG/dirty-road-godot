---
import { Image, getImage } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';

// Capturas reales del juego (generadas con tools/fotos_web.sh).
import etapa01 from '../../media/juego/etapas/etapa_01.png';
import etapa03 from '../../media/juego/etapas/etapa_03.png';
import etapa05 from '../../media/juego/etapas/etapa_05.png';
import etapa09 from '../../media/juego/etapas/etapa_09.png';
import etapa10 from '../../media/juego/etapas/etapa_10.png';
import boss05 from '../../media/juego/enemigos/boss_05_geiser.png';

const capturas = [
  { img: etapa01, t: 'El árbol central' },
  { img: etapa03, t: 'Océanos y plástico' },
  { img: etapa05, t: 'Lluvia ácida' },
  { img: etapa09, t: 'Deforestación' },
  { img: etapa10, t: 'Cambio climático' },
  { img: boss05, t: 'Jefe de etapa' },
];

const posterTrailer = await getImage({ src: etapa01, format: 'webp', width: 1280 });
---
<section id="galeria" data-tint="#47c9b0" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Galería"
        titulo="Mira el juego"
        descripcion="Capturas del gameplay: combate, jefes y escenarios temáticos."
      />
    </Reveal>

    <Reveal>
      <video
        class="mt-14 w-full rounded-[3px] border border-line"
        src="/video/trailer.mp4"
        poster={posterTrailer.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Trailer de Dirty Road"
      ></video>
    </Reveal>

    <div class="mt-14 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {capturas.map((cap, i) => (
        <Reveal delay={(i % 3) * 90}>
          <figure>
            <Image
              src={cap.img}
              alt={cap.t}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
              format="webp"
              loading="lazy"
              decoding="async"
              class="aspect-video w-full rounded-[3px] border border-line object-cover"
            />
            <figcaption class="mt-3 text-sm text-moss">{cap.t}</figcaption>
          </figure>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<script>
  // El trailer solo reproduce cuando está a la vista (ahorra CPU y batería).
  const trailer = document.querySelector<HTMLVideoElement>('#galeria video');
  if (trailer) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      trailer.autoplay = false;
      trailer.pause();
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) void trailer.play().catch(() => {});
          else trailer.pause();
        },
        { threshold: 0.25 },
      );
      io.observe(trailer);
    }
  }
</script>
