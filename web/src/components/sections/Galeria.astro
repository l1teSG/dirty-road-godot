---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';

// Capturas reales del juego (generadas con tools/fotos_web.sh).
const capturas = [
  { src: '/images/juego/etapas/etapa_01.png', t: 'El árbol central' },
  { src: '/images/juego/etapas/etapa_03.png', t: 'Océanos y plástico' },
  { src: '/images/juego/etapas/etapa_05.png', t: 'Lluvia ácida' },
  { src: '/images/juego/etapas/etapa_09.png', t: 'Deforestación' },
  { src: '/images/juego/etapas/etapa_10.png', t: 'Cambio climático' },
  { src: '/images/juego/enemigos/boss_05_geiser.png', t: 'Jefe de etapa' },
];
---
<section id="galeria" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Galería"
        titulo="Mira el juego"
        descripcion="Capturas del gameplay: combate, jefes y escenarios temáticos."
      />
    </Reveal>

    <Reveal>
      <video
        class="mt-14 w-full rounded-[3px] border border-line"
        src="/video/trailer.mp4"
        poster="/images/juego/etapas/etapa_01.png"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Trailer de Dirty Road"
      ></video>
    </Reveal>

    <div class="mt-14 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {capturas.map((cap, i) => (
        <Reveal delay={(i % 3) * 90}>
          <figure>
            <img
              src={cap.src}
              alt={cap.t}
              loading="lazy"
              decoding="async"
              class="aspect-video w-full rounded-[3px] border border-line object-cover"
            />
            <figcaption class="mt-3 text-sm text-moss">{cap.t}</figcaption>
          </figure>
        </Reveal>
      ))}
    </div>
  </div>
</section>
