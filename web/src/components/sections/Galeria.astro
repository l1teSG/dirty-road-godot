---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';

// Marcadores de captura (sustituir por imágenes reales del juego).
const capturas = [
  { t: 'El árbol central', c: '#141a10' },
  { t: 'Oleadas de enemigos', c: '#161c12' },
  { t: 'Jefe de etapa', c: '#1a1410' },
  { t: 'Escenario ácido', c: '#171b10' },
  { t: 'Mejoras entre oleadas', c: '#101a16' },
  { t: 'Cambio climático', c: '#1a120c' },
];
---
<section id="galeria" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Galería"
        titulo="Mira el juego"
        descripcion="Capturas del gameplay: combate, jefes y escenarios temáticos."
      />
    </Reveal>
    <div class="mt-14 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {capturas.map((cap) => (
        <Reveal>
          <figure>
            <div
              class="field-grid relative flex aspect-video items-center justify-center overflow-hidden rounded-[3px] border border-line"
              style={`background:${cap.c}`}
            >
              <span class="rounded-[3px] border border-line-strong bg-bg/60 px-3 py-1 text-xs text-moss">
                Captura pendiente
              </span>
            </div>
            <figcaption class="mt-3 text-sm text-moss">{cap.t}</figcaption>
          </figure>
        </Reveal>
      ))}
    </div>
  </div>
</section>
