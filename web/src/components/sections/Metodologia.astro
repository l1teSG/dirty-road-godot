---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { metodologia } from '../../lib/apa';
---
<section id="metodologia" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-4xl">
    <Reveal>
      <SectionHeading
        kicker="Capítulos 4-6"
        titulo={metodologia.titulo}
        descripcion={metodologia.texto}
        centrado
      />
    </Reveal>
    <Reveal>
      <ul class="mt-12 flex flex-wrap justify-center gap-x-8 gap-y-3">
        {metodologia.herramientas.map((h) => (
          <li class="flex items-center gap-3 text-sm font-medium text-bone">
            <span class="h-1.5 w-1.5 rounded-[1px] bg-leaf" aria-hidden="true" />
            {h}
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
