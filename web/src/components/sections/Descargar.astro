---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import DownloadButton from '../DownloadButton';
import GitHubStats from '../GitHubStats';
import Changelog from '../Changelog';

const owner = 'l1teSG';
const repo = 'dirty-road-godot';
---
<section id="descargar" class="px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-3xl text-center">
    <Reveal>
      <SectionHeading
        kicker="Juega gratis"
        titulo="Descarga Dirty Road"
        descripcion="Disponible como descarga gratuita. Elige tu plataforma y empieza a defender el árbol."
        centrado
      />
    </Reveal>
    <Reveal delay={100}>
      <div class="mx-auto mt-10 max-w-xl rounded-2xl border border-green/15 bg-bg-alt/60 p-8 backdrop-blur-sm">
        <DownloadButton client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={150}>
      <div class="mt-8">
        <GitHubStats client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={200}>
      <div class="mx-auto mt-12 max-w-2xl text-left">
        <h3 class="mb-4 text-center text-lg font-semibold text-green-bright">Novedades</h3>
        <Changelog client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={250}>
      <a
        href={`https://github.com/${owner}/${repo}/releases`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-block text-sm text-text-secondary underline underline-offset-4 hover:text-green-bright"
      >
        Ver todas las versiones en GitHub →
      </a>
    </Reveal>
  </div>
</section>
