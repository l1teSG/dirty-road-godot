---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import DownloadButton from '../DownloadButton';
import GitHubStats from '../GitHubStats';
import Changelog from '../Changelog';

const owner = 'l1teSG';
const repo = 'dirty-road-godot';
---
<section id="descargar" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-3xl text-center">
    <Reveal>
      <SectionHeading
        kicker="Juega gratis"
        titulo="Descarga Dirty Road"
        descripcion="Disponible gratis para Android (APK). Descarga, instala y empieza a defender el árbol."
        centrado
      />
    </Reveal>
    <Reveal delay={100}>
      <div class="tile mx-auto mt-12 max-w-xl p-8">
        <DownloadButton client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={150}>
      <div class="mt-8">
        <GitHubStats client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={200}>
      <div class="mx-auto mt-14 max-w-2xl text-left">
        <h3 class="mb-4 border-b border-line pb-3 text-lg font-semibold text-bone">Novedades</h3>
        <Changelog client:load owner={owner} repo={repo} />
      </div>
    </Reveal>
    <Reveal delay={250}>
      <a
        href={`https://github.com/${owner}/${repo}/releases`}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-10 inline-flex items-center gap-3 text-sm text-moss transition-colors hover:text-bone"
      >
        Ver todas las versiones en GitHub
        <span class="h-px w-8 bg-leaf transition-all duration-300 group-hover:w-14" aria-hidden="true"></span>
      </a>
    </Reveal>
  </div>
</section>
