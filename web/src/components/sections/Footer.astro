---
// Pie de página: licencia, repositorio y créditos.
const year = new Date().getFullYear();
---
<footer class="border-t border-line px-4 py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 text-center text-sm text-moss">
    <p class="text-[1.05rem] font-bold tracking-tight text-bone">
      Dirty <span class="text-leaf">Road</span>
    </p>
    <p>Videojuego educativo ambiental. Software propietario.</p>
    <a
      href="https://github.com/l1teSG/dirty-road-godot"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-4 transition-colors hover:text-bone"
    >
      l1teSG/dirty-road-godot
    </a>
    <p class="mt-2">&copy; {year} Dirty Road. Todos los derechos reservados.</p>
  </div>
</footer>
