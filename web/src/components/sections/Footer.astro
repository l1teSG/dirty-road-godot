---
// Pie de página: licencia, repositorio y créditos.
const year = new Date().getFullYear();
---
<footer class="border-t border-white/5 px-4 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 text-center text-sm text-text-secondary">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-green">Dirty Road</p>
    <p>Videojuego educativo ambiental · Software propietario</p>
    <p>
      <a
        href="https://github.com/l1teSG/dirty-road-godot"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:text-green-bright"
      >
        l1teSG/dirty-road-godot
      </a>
    </p>
    <p class="mt-2">&copy; {year} Dirty Road. Todos los derechos reservados.</p>
  </div>
</footer>
