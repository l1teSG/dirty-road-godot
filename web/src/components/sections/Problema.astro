---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { problema, justificacion } from '../../lib/apa';
---
<section id="problema" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading kicker="Capítulo 1" titulo={problema.titulo} />
    </Reveal>
    <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-14">
      <Reveal>
        <p class="max-w-[60ch] text-lg leading-relaxed text-moss">{problema.texto}</p>
      </Reveal>
      <Reveal delay={120}>
        <div class="tile p-7" style="border-left:2px solid var(--color-leaf)">
          <h3 class="text-lg font-semibold text-bone">{justificacion.titulo}</h3>
          <p class="mt-4 text-sm leading-relaxed text-moss">{justificacion.texto}</p>
        </div>
      </Reveal>
    </div>
  </div>
</section>
