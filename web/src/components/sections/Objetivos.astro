---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { objetivosEspecificos } from '../../lib/apa';
---
<section id="objetivos" class="px-4 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Capítulo 2"
        titulo="Objetivos"
        descripcion="Desarrollar un videojuego educativo en Godot dirigido a jóvenes mayores de 10 años que aborde, de forma interactiva, la contaminación, el reciclaje y la deforestación."
      />
    </Reveal>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {objetivosEspecificos.map((o, i) => (
        <Reveal delay={i * 80}>
          <div class="flex gap-4 rounded-xl border border-white/5 bg-bg-alt/60 p-5">
            <span class="font-mono text-sm text-green">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-sm leading-relaxed text-text-secondary">{o}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
