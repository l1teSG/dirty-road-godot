---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { objetivosEspecificos } from '../../lib/apa';
---
<section id="objetivos" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Capítulo 2"
        titulo="Objetivos"
        descripcion="Desarrollar un videojuego educativo en Godot dirigido a jóvenes mayores de 10 años que aborde, de forma interactiva, la contaminación, el reciclaje y la deforestación."
      />
    </Reveal>
    <Reveal>
      <ul class="mt-14 grid gap-x-14 gap-y-6 sm:grid-cols-2">
        {objetivosEspecificos.map((o) => (
          <li class="flex gap-4 border-t border-line pt-5">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[1px] bg-leaf" aria-hidden="true" />
            <p class="text-sm leading-relaxed text-moss">{o}</p>
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
