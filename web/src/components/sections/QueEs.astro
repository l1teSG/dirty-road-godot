---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';

const pilares = [
  {
    t: 'Aprende jugando',
    d: 'Cada enemigo representa un problema ambiental real y enseña algo al aparecer.',
    c: 'leaf',
  },
  {
    t: 'Infinito y dinámico',
    d: '10 etapas y oleadas que escalan: el mundo evoluciona mientras avanzas.',
    c: 'rad',
  },
  {
    t: 'Basado en evidencia',
    d: 'Gamificación y aprendizaje significativo para una experiencia lúdica y educativa.',
    c: 'resin',
  },
];
---
<section id="que-es" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="El proyecto"
        titulo="¿Qué es Dirty Road?"
        descripcion="Un videojuego educativo 2D desarrollado en Godot Engine, enfocado en fomentar la conciencia ambiental en jóvenes mayores de 10 años mediante la gamificación."
      />
    </Reveal>
    <div class="mt-14 grid gap-px overflow-hidden rounded-[3px] border border-line bg-line sm:grid-cols-3">
      {pilares.map((p) => (
        <Reveal class="h-full">
          <article class="h-full bg-surface p-7" style={`border-top:2px solid var(--color-${p.c})`}>
            <h3 class="text-lg font-semibold text-bone">{p.t}</h3>
            <p class="mt-3 text-sm leading-relaxed text-moss">{p.d}</p>
          </article>
        </Reveal>
      ))}
    </div>
  </div>
</section>
