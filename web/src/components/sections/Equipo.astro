---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { equipo } from '../../lib/apa';

const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---
<section id="equipo" data-tint="#e3a63b" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Recursos humanos"
        titulo="Equipo de desarrollo"
        descripcion="Proyecto desarrollado en el marco de la Articulación SENA, Técnico en Desarrollo de Software."
      />
    </Reveal>
    <div class="mt-14 grid gap-px overflow-hidden rounded-[3px] border border-line bg-line sm:grid-cols-3">
      {equipo.map((m, i) => (
        <Reveal class="h-full" delay={i * 100}>
          <article class="h-full bg-surface p-7">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-[3px] border border-line-strong font-semibold text-leaf"
            >
              {iniciales(m.nombre)}
            </div>
            <h3 class="mt-4 font-semibold text-bone">{m.nombre}</h3>
            <p class="mt-2 text-sm leading-relaxed text-moss">{m.rol}</p>
          </article>
        </Reveal>
      ))}
    </div>
    <Reveal delay={150}>
      <p class="mt-8 text-sm text-moss">
        I.E. Técnico Industrial “Julio Flórez”, Especialidad Sistemas Informáticos. Articulación SENA,
        Técnico en Desarrollo de Software.
      </p>
    </Reveal>
  </div>
</section>
