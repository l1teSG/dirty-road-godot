---
import SectionHeading from '../ui/SectionHeading.astro';
import Reveal from '../ui/Reveal.astro';
import { marcoTecnico, referencias } from '../../lib/apa';
---
<section id="marco" class="border-t border-line px-4 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <SectionHeading
        kicker="Capítulo 3"
        titulo={marcoTecnico.titulo}
        descripcion={marcoTecnico.texto}
      />
    </Reveal>
    <Reveal>
      <ul class="mt-14 grid gap-x-14 gap-y-5 sm:grid-cols-2">
        {referencias.map((r) => (
          <li class="border-l-2 border-leaf/40 pl-4 text-sm leading-relaxed text-moss">{r}</li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
