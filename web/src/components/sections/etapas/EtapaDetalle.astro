---
/**
 * Formato compartido de una etapa. Cada etapa vive en su propio archivo
 * (`etapa_01.astro` … `etapa_10.astro`) y solo aporta su contenido; la
 * presentación se mantiene idéntica entre todas.
 *
 * Cada etapa es una tarjeta con marco (borde + color de etapa en la cabecera) y
 * tres bloques, siempre en el mismo orden:
 *   1. El problema  → qué pasa en el mundo real.
 *   2. Enemigos del juego → qué representa cada uno (desplegable con sus datos).
 *   3. Soluciones reales → qué se puede hacer de verdad.
 */
export interface EnemigoEtapa {
  nombre: string;
  representa: string;
  datos: string[];
}

export interface Props {
  n: number;
  nombre: string;
  color: string;
  problema: string;
  problemas: string[];
  enemigos: EnemigoEtapa[];
  soluciones: string[];
  accion: string;
}

const { n, nombre, color, problema, problemas, enemigos, soluciones, accion } = Astro.props;
const num = String(n).padStart(2, '0');
---

<article
  id={`etapa-${n}`}
  data-tint={color}
  class="scroll-mt-28 overflow-hidden rounded-[4px] border border-line bg-surface/50"
>
  <!-- Cabecera de la tarjeta -->
  <header
    class="flex items-center gap-4 border-b border-line px-5 py-4 sm:px-7"
    style={`border-top:2px solid ${color}`}
  >
    <span class="text-3xl font-bold leading-none tabular-nums text-moss/60 sm:text-4xl">{num}</span>
    <span class="h-3 w-3 shrink-0 rounded-[1px]" style={`background:${color}`} aria-hidden="true"></span>
    <h3 class="text-base font-semibold text-bone sm:text-lg">{nombre}</h3>
  </header>

  <div class="grid gap-8 p-5 sm:p-7 md:grid-cols-3 md:gap-6 lg:gap-10">
    <!-- 1 · El problema -->
    <div data-reveal class="reveal">
      <h4 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-bone">
        <span class="h-px w-5" style={`background:${color}`} aria-hidden="true"></span>
        El problema
      </h4>
      <p class="mt-4 text-sm leading-relaxed text-moss">{problema}</p>
      <ul class="mt-4 space-y-2.5">
        {problemas.map((p) => (
          <li class="flex gap-3 text-sm leading-relaxed text-moss">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-[1px]" style={`background:${color}`} aria-hidden="true" />
            {p}
          </li>
        ))}
      </ul>
    </div>

    <!-- 2 · Enemigos del juego (desplegables) -->
    <div data-reveal class="reveal" style="transition-delay:90ms">
      <h4 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-bone">
        <span class="h-px w-5" style={`background:${color}`} aria-hidden="true"></span>
        Enemigos del juego
      </h4>
      <ul class="mt-4 space-y-1">
        {enemigos.map((e) => (
          <li>
            <details class="group border-t border-line first:border-t-0">
              <summary class="flex cursor-pointer list-none items-start gap-3 py-3 [&::-webkit-details-marker]:hidden">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-[1px]" style={`background:${color}`} aria-hidden="true" />
                <span class="flex-1">
                  <span class="block text-sm font-medium text-bone">{e.nombre}</span>
                  <span class="mt-0.5 block text-xs leading-relaxed text-moss">{e.representa}</span>
                </span>
                <svg
                  viewBox="0 0 24 24"
                  class="mt-0.5 h-4 w-4 shrink-0 text-moss transition-transform duration-200 group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="mb-2 space-y-1.5 pb-3 pl-5">
                {e.datos.map((d) => (
                  <li class="flex gap-2 text-xs leading-relaxed text-moss">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-leaf" aria-hidden="true" />
                    {d}
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </div>

    <!-- 3 · Soluciones reales -->
    <div data-reveal class="reveal" style="transition-delay:180ms">
      <h4 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-bone">
        <span class="h-px w-5" style={`background:${color}`} aria-hidden="true"></span>
        Soluciones reales
      </h4>
      <ul class="mt-4 space-y-2.5">
        {soluciones.map((s) => (
          <li class="flex gap-3 text-sm leading-relaxed text-moss">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-[1px] bg-leaf" aria-hidden="true" />
            {s}
          </li>
        ))}
      </ul>
      <p class="mt-4 border-l-2 pl-4 text-sm leading-relaxed text-bone" style={`border-color:${color}`}>
        {accion}
      </p>
    </div>
  </div>
</article>
