---
// Barra de navegación fija y responsive (menú móvil con botón).
const links = [
  { href: '#que-es', label: 'El proyecto' },
  { href: '#mecanicas', label: 'Mecánicas' },
  { href: '#etapas', label: 'Etapas' },
  { href: '#galeria', label: 'Galería' },
  { href: '#equipo', label: 'Equipo' },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3">
    <a href="#top" class="text-[1.05rem] font-bold tracking-tight text-bone">
      Dirty <span class="text-leaf">Road</span>
    </a>

    <ul class="ml-auto hidden items-center gap-6 text-sm text-moss md:flex">
      {links.map((l) => (
        <li>
          <a class="transition-colors hover:text-bone" href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>

    <a
      href="#descargar"
      class="ml-auto hidden rounded-[3px] bg-resin px-4 py-1.5 text-sm font-semibold text-bg transition-colors hover:bg-[#f0b451] md:ml-6 md:inline-block"
    >
      Descargar
    </a>

    <button
      id="menu-btn"
      class="ml-auto rounded-[3px] border border-line px-3 py-1.5 text-lg text-bone md:hidden"
      aria-label="Abrir menú"
    >
      ☰
    </button>
  </nav>

  <div id="menu-panel" class="hidden border-t border-line bg-bg md:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3 text-moss">
      {links.map((l) => (
        <li>
          <a class="block rounded-[3px] px-3 py-2.5 hover:bg-surface hover:text-bone" href={l.href}>
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a
          class="mt-1 block rounded-[3px] bg-resin px-3 py-2.5 text-center font-semibold text-bg"
          href="#descargar"
        >
          Descargar
        </a>
      </li>
    </ul>
  </div>

  <div id="scroll-progress" class="absolute inset-x-0 bottom-0 h-[2px] bg-leaf" aria-hidden="true"></div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const panel = document.getElementById('menu-panel');
  if (btn && panel) {
    btn.addEventListener('click', () => panel.classList.toggle('hidden'));
    panel.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => panel.classList.add('hidden')),
    );
  }
</script>
