---
// Página principal de descarga de Dirty Road.
// Ensambla todos los componentes: Hero, GitHubStats, Changelog,
// ScreenshotGallery y Footer dentro del BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import GitHubStats from '../components/GitHubStats';
import Changelog from '../components/Changelog';
import ScreenshotGallery from '../components/ScreenshotGallery';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Dirty Road - Videojuego educativo ambiental"
  description="Videojuego educativo 2D que fomenta la conciencia ambiental. Recolecta, recicla y reforesta con Renata."
>
  <main>
    <Hero client:load />
    <section class="px-4 py-12">
      <GitHubStats client:load owner="l1teSG" repo="dirty-road-godot" />
    </section>
    <section class="px-4 py-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-2xl font-semibold text-text-primary sm:text-3xl">
          Novedades
        </h2>
        <Changelog client:load owner="l1teSG" repo="dirty-road-godot" />
      </div>
    </section>
    <ScreenshotGallery client:load />
    <Footer />
  </main>
</BaseLayout>
