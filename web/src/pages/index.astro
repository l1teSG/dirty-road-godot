---
// Landing de Dirty Road — una sola página, centrada en el scroll.
// index.astro SOLO ensambla; cada sección vive en su propio archivo.
import BaseLayout from '../layouts/BaseLayout.astro';
import FondoMenu from '../components/FondoMenu.tsx';
import Navbar from '../components/Navbar.astro';

import Hero from '../components/sections/Hero.astro';
import QueEs from '../components/sections/QueEs.astro';
import Problema from '../components/sections/Problema.astro';
import Objetivos from '../components/sections/Objetivos.astro';
import Mecanicas from '../components/sections/Mecanicas.astro';
import Etapas from '../components/sections/Etapas.astro';
import Galeria from '../components/sections/Galeria.astro';
import MarcoTeorico from '../components/sections/MarcoTeorico.astro';
import Metodologia from '../components/sections/Metodologia.astro';
import Equipo from '../components/sections/Equipo.astro';
import Descargar from '../components/sections/Descargar.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout
  title="Dirty Road — Videojuego educativo ambiental"
  description="Shooter de supervivencia con temática ecológica. Defiende el último árbol, recolecta, recicla y reforesta a través de 10 etapas."
>
  <FondoMenu client:load />
  <Navbar />
  <main>
    <Hero />
    <QueEs />
    <Problema />
    <Objetivos />
    <Mecanicas />
    <Etapas />
    <Galeria />
    <MarcoTeorico />
    <Metodologia />
    <Equipo />
    <Descargar />
  </main>
  <Footer />
</BaseLayout>
