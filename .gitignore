# Ignorar una carpeta completa (y todo su contenido)
.godot/
.import/
export/
build/
node_modules/
addons/
assets/
# Entorno virtual de Python
.venv/
venv/
ENV/
env/

*.sh
*.sh.*
Miniconda3-latest-Linux-x86_64*
dirty-road/addons/godotty/bin/libgodotty.macos.dylib

# Ignorar archivos específicos por extensión
*.log
*.tmp

# Ignorar archivos ocultos o del sistema
.DS_Store

# Archivos temporales de LibreOffice/Word (locks) y derivados .odt de los
# documentos de docs/: no se versionan, se regeneran al abrir/guardar.
**/.~lock.*#
*.odt

apk/
*.apk
*.aab
*.idsig
.aider*

# Excepción: versionar las cartas (catálogo, descripciones, efectos).
# assets/ está ignorado, pero las cartas son datos del juego que deben viajar.
!dirty-road/assets/
dirty-road/assets/*
!dirty-road/assets/cards/
!dirty-road/assets/cards/**

# Excepción: assets del folleto (docs/folleto), versionados a propósito.
!docs/folleto/assets/

# Material generado por las herramientas (fotos/trailers).
capturas/

# Excepción: versionar los scripts de herramientas (*.sh está ignorado).
!dirty-road/tools/capturas.sh
!dirty-road/tools/trailer.sh
!dirty-road/tools/fotos_web.sh
!dirty-road/tools/trailer_juego.sh
!dirty-road/tools/regenerar.sh

# Caché de Python (herramientas).
__pycache__/
*.pyc
